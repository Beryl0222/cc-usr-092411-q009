{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "银龄多形态课程接续领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "COURSE_PUBLISHED",
        "ENROLLMENT_PLACED",
        "WAITLIST_PROMOTED",
        "WAITLIST_RELEASED",
        "PAUSE_FROZEN",
        "PAUSE_RESUMED",
        "ENROLLMENT_ENDED",
        "SUBSIDY_ALLOCATED",
        "SUBSIDY_RETURNED",
        "SUBSIDY_RELINKED",
        "SESSION_RECORDED",
        "PRACTICE_RECORDED",
        "CAREGIVER_GRANTED",
        "CAREGIVER_REVOKED",
        "TEACHER_CHANGED",
        "COURSE_CANCELLED",
        "PROPOSAL_OPENED",
        "PROPOSAL_CHOICE_RECORDED",
        "PROPOSAL_CONFIRMED",
        "PROPOSAL_REJECTED",
        "PROPOSAL_DISPUTED",
        "PROPOSAL_EXPIRED",
        "PROPOSAL_RESOLVED",
        "SESSIONS_MIGRATED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "learner_profile",
        "course_offering",
        "enrollment",
        "learning_record",
        "continuity_proposal"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "event_key": {
      "type": ["string", "null"],
      "description": "命令级幂等键：同键内容一致时按重放空转，内容冲突时拒绝"
    },
    "payload": {
      "type": "object",
      "description": "事件明细，具体结构由事件类型决定，时间字段使用 ISO-8601"
    }
  },
  "additionalProperties": true
}
