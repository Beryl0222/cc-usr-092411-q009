{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "银龄多形态课程接续领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "COURSE_PUBLISHED",
        "COURSE_CANCELLED",
        "ENROLLMENT_PLACED",
        "ENROLLMENT_PAUSED",
        "ENROLLMENT_RESUMED",
        "SESSION_FROZEN",
        "SEAT_RELEASED",
        "WAITLIST_PROMOTED",
        "TRANSFER_PROPOSED",
        "TRANSFER_CONFIRMED",
        "TRANSFER_BATCH_APPLIED",
        "PROPOSAL_REJECTED",
        "PROPOSAL_HELD",
        "SUBSIDY_LEDGERED",
        "ATTENDANCE_RECORDED",
        "PHONE_CONFIRMATION_RECORDED",
        "CAREGIVER_AUTHORIZED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "learner_profile",
        "course_offering",
        "enrollment",
        "learning_record"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "actor": {
      "type": ["string", "null"]
    },
    "causation_id": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
